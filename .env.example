# Copier en .env.local pour le développement ; en production, les définir dans
# Vercel (Project Settings > Environment Variables). Ne jamais les commiter.

# Clé API Resend (https://resend.com/api-keys), lue seulement côté serveur.
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire de contact.
# Avec l'expéditeur de test onboarding@resend.dev, ce doit être l'email du compte Resend.
CONTACT_TO_EMAIL=

# Facultatif : expéditeur sur un domaine vérifié dans Resend.
# Par défaut : Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# URL publique du site (sitemap, OpenGraph). Par défaut : http://localhost:3000
NEXT_PUBLIC_SITE_URL=
